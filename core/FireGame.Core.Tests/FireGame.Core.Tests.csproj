<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>FireGame.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 연출 판정 로직은 Unity 폴더에 있지만 UnityEngine을 안 쓰므로 여기서 실제 판으로 검증한다. -->
    <Compile Include="../../unity/Assets/Scripts/Unity/Feel/*.cs" LinkBase="Feel" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FireGame.Core/FireGame.Core.csproj" />
  </ItemGroup>

</Project>
